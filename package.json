{
  "name": "evidence-shot",
  "version": "1.0.19",
  "type": "commonjs",
  "description": "EvidenceShot: Web テスト時の証跡用に、ポップアップから表示領域やスクロール連結撮影を行い、多彩なタイムスタンプ付きで保存できる Chrome スクリーンショット拡張機能",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots",
    "build:firefox": "node scripts/build-firefox.js"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.1",
    "puppeteer": "^25.4.0",
    "sharp": "^0.35.3",
    "web-ext": "^10.5.0"
  },
  "keywords": [
    "chrome-extension",
    "screenshot",
    "full-page",
    "web-testing"
  ],
  "author": "",
  "license": "MIT"
}
